# Copier ce fichier en backend/.env puis adapter les valeurs.
# Le fichier .env n'est jamais commité (voir .gitignore).

# Base de développement (PostgreSQL 16)
DATABASE_URL=postgresql+psycopg://smartcampus:smartcampus@localhost:5432/smartcampus

# Base de test utilisée par pytest : son nom doit finir par _test
TEST_DATABASE_URL=postgresql+psycopg://smartcampus:smartcampus@localhost:5432/smartcampus_test

# Jeton JWT (ENF-02) : au moins 32 caractères aléatoires
JWT_SECRET=remplacer-par-une-longue-chaine-aleatoire-de-32-caracteres
ACCESS_TOKEN_MINUTES=30

# Seules les adresses de ce domaine peuvent se connecter (RG-11)
ALLOWED_EMAIL_DOMAIN=usms.ac.ma

# Blocage après échecs de connexion (RG-02)
MAX_FAILED_ATTEMPTS=3
LOCK_MINUTES=15

# Coût bcrypt (ENF-01)
BCRYPT_ROUNDS=12

# Mot de passe des comptes de démonstration créés par « python -m src.seed »
SEED_PASSWORD=SmartCampus2026!
